{
	"name": "@jide/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "JIDE — 自测闭环优先的轻量 Agentic IDE",
	"author": "JIDE contributors",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "bun scripts/dev.mjs",
		"build": "bunx vite build && bun run daemon:build && bun run shell:build && electron-builder --win",
		"package:dir": "bunx vite build && bun run daemon:build && bun run shell:build && electron-builder --win --dir",
		"daemon:build": "bun build src/bun/daemon.ts --target=node --external:node-pty --outfile dist-daemon/jide-daemon.js",
		"shell:build": "bun build electron/main.ts --target=node --format=cjs --packages=external --outfile dist-electron/main.js && bun build electron/preload.ts --target=node --format=cjs --packages=external --outfile dist-electron/preload.js"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@jide/contracts": "workspace:*",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"codemirror": "^6.0.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"react-virtuoso": "^4.18.20",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"zustand": "^5.0.8",
		"@jide/ui": "workspace:*"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/node": "^24",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.2.1",
		"electron": "^45.2.1",
		"electron-builder": "^26.18.0",
		"node-pty": "^1.1.0",
		"tailwindcss": "^4.3.3",
		"typebox": "^1.4.3",
		"vite": "^8.3.5",
		"ws": "^8.22.1"
	}
}