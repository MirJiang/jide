{
	"name": "jide",
	"private": true,
	"version": "0.1.0",
	"description": "JIDE — 自测闭环优先的轻量 Agentic IDE(Electron + React + pi 内核)",
	"trustedDependencies": [
		"electron"
	],
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "cd apps/desktop && bun run dev",
		"build": "cd apps/desktop && bun run build",
		"test": "bun test packages/contracts packages/jide-ui apps/desktop",
		"typecheck": "tsc -p packages/contracts && tsc -p apps/desktop",
		"tokens:generate": "bun packages/jide-ui/scripts/generate-tokens.mjs"
	},
	"devDependencies": {
		"typescript": "~5.9.3"
	},
	"dependencies": {
		"remixicon": "^4.9.1"
	}
}
